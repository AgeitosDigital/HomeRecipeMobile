# Copy to .env.local — client-safe values only. Never commit secrets.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_URL=http://localhost:3000

# RevenueCat public SDK keys (Dashboard → Project → API keys)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Optional: use RN fetch instead of Expo winter fetch (helps Expo Go LogBox spam)
# EXPO_PUBLIC_USE_RN_FETCH=true

# Optional later:
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Local Import URL stack (scripts only — not read by Expo):
# Path to the web monorepo root that contains services/recipe-url-import/
# HOMERECIPE_WEB_ROOT=/Users/you/Documents/HomeRecipe/AI-Recipe-App/HomeRecipe
