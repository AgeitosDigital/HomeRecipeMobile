{
  "expo": {
    "name": "HomeRecipe",
    "slug": "HomeRecipeMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/homerecipelogo1-removebg.png",
    "scheme": "homerecipemobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ageitosdigital.homerecipe",
      "icon": "./assets/brand/homerecipelogo1-removebg.png"
    },
    "android": {
      "package": "com.ageitosdigital.homerecipe",
      "adaptiveIcon": {
        "backgroundColor": "#f7f9f7",
        "foregroundImage": "./assets/brand/homerecipelogo1-removebg.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f9f7",
          "image": "./assets/brand/homerecipelogo1-removebg.png",
          "imageWidth": 120
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
